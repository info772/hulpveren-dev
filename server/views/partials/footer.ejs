    <!-- Route A: server-rendered header/footer; JS only binds behaviors -->
    <% const useLayout = typeof useLayout === "boolean" ? useLayout : true; %>
    <!-- Route A: server-rendered header/footer; JS only binds behaviors -->
    <% if (useLayout) { %>
      </main>
    </div>
    <% } %>
    <!-- Route A: server-rendered header/footer; JS only binds behaviors -->
    <footer id="site-footer" class="site-footer"></footer>
  </body>
</html>
