  <% displayKits.forEach(function(kit){
    const kitTypeLabelRaw = kit.kind_of_kit_nl || kit.kind_of_kit || kit.family_label || '';
    const kitTypeSource = String(kitTypeLabelRaw || '').toLowerCase();
    const kitTypeLabel =
      kitTypeSource.includes('auxiliary coil spring') ? 'Hulpverenset' :
      kitTypeSource.includes('reinforced coil spring') ? 'Versterkte hoofdveren' :
      kitTypeSource.includes('lowering springs') ? 'Verlagingsveren' :
      kitTypeSource.includes('air suspension') ? 'Luchtvering' :
      (kit.family_label || kitTypeLabelRaw || '');
    const kitSkuBaseForPosition = String(kit && kit.sku || '').trim().toUpperCase().replace(/^SD-/, 'HV-');
    const kitPositionRaw = String(kit.position || '').trim().toLowerCase().replace(/\s+/g, '');
    const kitPositionForDisplay = kitSkuBaseForPosition === 'HV-098273' ? 'front' : kitPositionRaw;
    const positionLabel =
      kitPositionForDisplay === 'front' ? 'Vooras' :
      kitPositionForDisplay === 'rear' ? 'Achteras' :
      kitPositionForDisplay === 'both' || kitPositionForDisplay === 'front,rear' ? 'Voor & achter' :
      (kit.position || '');
    const approvalLabel = kit.approval_nl || kit.approval || '';
    const normContext = function(v) {
      return String(v || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/-/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    };
    const generationSlugNorm = typeof generationSlug !== 'undefined' && generationSlug
      ? normContext(generationSlug)
      : '';
    const generationNameNorm = typeof generationName !== 'undefined' && generationName
      ? normContext(generationName)
      : '';

    const generationSlugParts = generationSlugNorm
      ? generationSlugNorm.split(/[^a-z0-9]+/).filter(Boolean)
      : [];
    const generationAliasParts = generationSlugParts.slice();
    const generationAliasAdd = function(value) {
      const cleaned = normContext(value);
      if (cleaned && generationAliasParts.indexOf(cleaned) === -1) generationAliasParts.push(cleaned);
    };

    const generationAliasHasPrefixMatch = function(codeNorm) {
      const parts = normContext(codeNorm).split(/[^a-z0-9]+/).filter(Boolean);
      if (!parts.length) return false;

      return parts.every(function(part) {
        return generationAliasParts.some(function(alias) {
          if (!alias || alias.length < 2) return false;

          // Match VAG-achtige platformcodes:
          // KL1/KL8 -> kl, 5F1/5F5/5F8 -> 5f, 3H7/3H8 -> 3h, 5P5/5P8 -> 5p
          if (part.indexOf(alias) === 0) return true;

          return false;
        });
      });
    };


    const currentBrandNorm = typeof brand !== 'undefined' ? normContext(brand) : '';
    const currentModelNorm = typeof model !== 'undefined' ? normContext(model) : '';

      // Opel Movano A/B/C generation aliases for card matching.
      // URL slugs are movano-a/movano-b/movano-c, source platform_codes are A (X70), B (X62), C (U9).
      if (currentBrandNorm === 'opel' && currentModelNorm === 'movano') {
        if (generationSlugNorm === 'movano a') {
          ['a', 'x70'].forEach(generationAliasAdd);
        }
        if (generationSlugNorm === 'movano b') {
          ['b', 'x62'].forEach(generationAliasAdd);
        }
        if (generationSlugNorm === 'movano c') {
          ['c', 'u9'].forEach(generationAliasAdd);
        }
      }


    if (
      currentBrandNorm === 'peugeot'
      && currentModelNorm === '107'
      && generationSlugNorm === '107'
    ) {
      ['107', 'pm', 'pn'].forEach(generationAliasAdd);
    }

    if (
      currentBrandNorm === 'peugeot'
      && currentModelNorm === '308'
    ) {
      if (generationSlugNorm === 'p5') {
        ['p5', 'iii', 'p51', 'p52', 'fb', 'fh', 'f3', 'fc', 'fj', 'f4'].forEach(generationAliasAdd);
      }

      if (generationSlugNorm === 't7') {
        // Peugeot 308 T7 hatchback/berline
        ['t7', 'i', '4a', '4c'].forEach(generationAliasAdd);
      }

      if (generationSlugNorm === 't7 sw') {
        // Peugeot 308 T7 SW/break
        ['t7 sw', 'sw', '4e', '4h'].forEach(generationAliasAdd);
      }
    }

    if (
      currentBrandNorm === 'mercedes benz'
      && currentModelNorm === 'sprinter'
      && generationSlugNorm === 'ok ka ac'
    ) {
      ['ok', 'ka', 'ac', '907', '910', 'w907', 'w910'].forEach(generationAliasAdd);
    }

    if (
      currentBrandNorm === 'volkswagen'
      && currentModelNorm === 'jetta'
      && generationSlugNorm === 'jetta 3'
    ) {
      ['16', 'v', '1k2', '1km'].forEach(generationAliasAdd);
    }

    if (
      currentBrandNorm === 'volkswagen'
      && currentModelNorm === 'tiguan'
      && generationSlugNorm === 'tiguan ad1'
    ) {
      ['ad1', '5n'].forEach(generationAliasAdd);
    }

    if (
      currentBrandNorm === 'volkswagen'
      && currentModelNorm === 'passat'
      && (
        generationSlugNorm === 'passat-b9'
        || generationSlugNorm === 'b9-cj5'
        || generationNameNorm === 'b9'
        || generationNameNorm === 'b9-cj5'
        || generationNameNorm.indexOf('b9') !== -1
        || generationNameNorm.indexOf('cj5') !== -1
      )
    ) {
      ['passat-b9', 'b9-cj5', 'b9', 'cj5'].forEach(generationAliasAdd);
    }


    if (
      normContext(brand) === 'peugeot'
      && normContext(model) === '308'
      && (generationSlugNorm === 't9' || generationNameNorm === 't9')
    ) {
      ['ii', 'lb', 'lh', 'lp', 'lw', 'l3', 'lc', 'lj', 'lr', 'lx', 'l4'].forEach(function(code) {
        if (generationAliasParts.indexOf(code) === -1) generationAliasParts.push(code);
      });
    }

    function fitmentMatchesCurrentGeneration(f) {
      if (!generationSlugNorm && !generationNameNorm) return true;
      if (
        normContext(brand) === 'ford' &&
        normContext(model) === 'transit'
      ) {
        const requestedTransitText = generationSlugNorm + ' ' + generationNameNorm;
        const transitTypeMatch = requestedTransitText.match(/(^|\s)(260|280|290|300|310|330|350|470|500)(\s|$)/);
        const transitPlatformMatch = requestedTransitText.match(/(^|[^a-z0-9])(v363|fa)(?=[^a-z0-9]|$)/);

        if (transitTypeMatch) {
          const transitType = transitTypeMatch[2];
          const requestedTransitPlatform = transitPlatformMatch ? transitPlatformMatch[2] : '';
          const transitText = normContext([
            f.generation,
            Array.isArray(f.platform_codes) ? f.platform_codes.join(' ') : f.platform_codes,
            f.engine_raw,
            f.remark,
            f.notes
          ].filter(Boolean).join(' '));

          const hasExplicitTransitType = new RegExp('(^|\\s)' + transitType + '(\\s|$)').test(transitText);
          const hasRequestedTransitPlatform = !requestedTransitPlatform || new RegExp('(^|[^a-z0-9])' + requestedTransitPlatform + '(?=[^a-z0-9]|$)').test(transitText);
          const isGenericV363 = /(^|[^a-z0-9])v363(?=[^a-z0-9]|$)/.test(transitText);
          const hasDoubleRear = /double rear wheel|twin rear wheel|twin wheels/.test(transitText);
          const excludesDoubleRear = /excl\.? twin rear wheel|excl\.? double rear wheel|excl\.? twin wheels|niet voor twin rear wheel|niet voor double rear wheel/.test(transitText);
          const isFwd = /(^|\s)fwd(\s|$)|voorwielaandrijving/.test(transitText);
          const onlyETransit = /only e transit|only etransit/.test(transitText);

          if (!hasRequestedTransitPlatform) return false;
          if (onlyETransit && !hasExplicitTransitType) return false;
          if (hasExplicitTransitType) return true;

          if (transitType === '500' && requestedTransitPlatform === 'v363' && isGenericV363 && hasDoubleRear && !excludesDoubleRear && !isFwd) return true;

          return false;
        }
      }


      const codes = Array.isArray(f.platform_codes)
        ? f.platform_codes.filter(Boolean)
        : [];

      if (
        currentBrandNorm === 'peugeot'
        && currentModelNorm === '308'
        && (generationSlugNorm === 't7' || generationSlugNorm === 't7 sw')
      ) {
        const peugeot308CodeText = normContext([
          f.generation,
          codes.join(' '),
          f.engine_raw,
          f.remark,
          f.notes
        ].filter(Boolean).join(' '));

        const isSwFitment = /(^|\s)(sw|break|station)(\s|$)/.test(peugeot308CodeText)
          || /(^|\s)(4e|4h)(\s|$)/.test(peugeot308CodeText);

        const isHbFitment = /(^|\s)(4a|4c)(\s|$)/.test(peugeot308CodeText);

        if (generationSlugNorm === 't7 sw') {
          return isSwFitment;
        }

        if (generationSlugNorm === 't7') {
          return isHbFitment || !isSwFitment;
        }
      }

      if (!codes.length) return true;

      const codeNorms = codes.map(function(code) {
        return normContext(code);
      }).filter(Boolean);

      const combinedCodeNorm = normContext(codes.join(' '));
      const compactCombinedCodeNorm = combinedCodeNorm.replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();

      if (combinedCodeNorm) {
        if (generationNameNorm && combinedCodeNorm === generationNameNorm) return true;
        if (generationSlugNorm && combinedCodeNorm === generationSlugNorm) return true;
        if (generationSlugNorm && generationSlugNorm.indexOf(compactCombinedCodeNorm) !== -1) return true;
        if (generationNameNorm && generationNameNorm.indexOf(compactCombinedCodeNorm) !== -1) return true;
        if (generationAliasParts.indexOf(compactCombinedCodeNorm) !== -1) return true;

        const combinedParts = compactCombinedCodeNorm.split(' ').filter(Boolean);
        if (combinedParts.length && combinedParts.every(function(part) {
          return generationSlugNorm.indexOf(part) !== -1
            || generationNameNorm.indexOf(part) !== -1
            || generationAliasHasPrefixMatch(part);
        })) {
          return true;
        }
      }

      return codeNorms.some(function(codeNorm) {
        if (!codeNorm) return false;

        if (generationNameNorm && codeNorm === generationNameNorm) return true;
        if (generationSlugNorm && codeNorm === generationSlugNorm) return true;
        if (generationAliasParts.indexOf(codeNorm) !== -1) return true;
        if (generationAliasHasPrefixMatch(codeNorm)) return true;

        if (codeNorm.length > 2 && generationSlugNorm.indexOf(codeNorm) !== -1) return true;
        if (generationNameNorm.length > 2 && codeNorm.indexOf(generationNameNorm) !== -1) return true;

        return false;
      });
    }

    let contextFitments = (kit.fitments || []).filter(function(f){
      return normContext(f.make) === normContext(brand)
        && normContext(f.model) === normContext(model)
        && fitmentMatchesCurrentGeneration(f);
