      if (/(?:^|[^a-z0-9])2wd(?=[^a-z0-9]|$).*(?:^|[^a-z0-9])(?:4wd|awd|4motion)(?=[^a-z0-9]|$)|(?:^|[^a-z0-9])(?:4wd|awd|4motion)(?=[^a-z0-9]|$).*(?:^|[^a-z0-9])2wd(?=[^a-z0-9]|$)/i.test(driveClean)) {
        filterDriveValues.length = 0;
        addUniqueFilterValue(filterDriveValues, '2wd');
        addUniqueFilterValue(filterDriveValues, '4wd');
      }

      const filterDrive = filterDriveValues.join(',');
      const filterRearWheels = filterRearWheelValues.join(',');

      const filterDriveLabel = filterDriveValues.length
        ? 'Aandrijving: ' + filterDriveValues.map(function(value) {
            if (value === '2wd') return '2WD';
            if (value === 'fwd') return 'Voorwielaandrijving';
            if (value === 'rwd') return 'Achterwielaandrijving';
            if (value === '4wd') return '4WD';
            return value;
          }).filter(Boolean).join(' / ')
        : '';

      const filterRearWheelsLabel = filterRearWheelValues.length
        ? 'Achterwielen: ' + filterRearWheelValues.map(function(value) {
            if (value === 'single') return 'Enkellucht';
            if (value === 'double') return 'Dubbellucht';
            return value;
          }).filter(Boolean).join(' / ')
        : '';

      const executionNote = typeof getSetExecutionNote === 'function'
        ? getSetExecutionNote(kit, contextFitments)
        : '';
      const visibleExecutionNote = (function(note, hardNote, hasBodyBadge) {
        if (!note) return '';
        const hard = String(hardNote || '').toLowerCase();
        let parts = String(note || '').split(' · ').filter(Boolean);

        if (hard.includes('chassis-cabine') || hasBodyBadge) {
          parts = parts.filter(function(part) {
            return part !== 'alleen chassis-cabine'
        && part !== 'niet voor chassis-cabine'
        && part.indexOf('Carrosserie:') !== 0;
          });
        }

        return parts.join(' · ');
      })(executionNote, hardCompatibilityNote, hasBodyFitmentBadge);
    %>
      <article class="platform-block set-card"
        data-set-filter-card
        data-filter-sku="<%= kit.sku %>"
        data-filter-load-type="<%= (String(kit && kit.sku || '').trim().toUpperCase().replace(/^SD-/, 'HV-') === 'HV-098111') ? 'continue_belading' : filterLoadType %>"
        data-filter-support-level="<%= filterSupportLevel %>"
        data-filter-position="<%= (String(kit && kit.sku || '').trim().toUpperCase().replace(/^SD-/, 'HV-') === 'HV-068418') ? 'front' : filterPosition %>"
        data-filter-mounting-type="<%= filterMountingType %>"
        data-filter-kit-kind="<%= filterKitKind %>"
          data-filter-engine="<%= filterLoweringEngineValue %>"
          data-filter-engine-label="<%= filterLoweringEngineLabel %>"
          data-filter-engine-labels="<%= filterLoweringEngineLabelMap %>"
          data-filter-lowering-note="<%= filterLoweringNoteValue %>"
          data-filter-lowering-note-label="<%= filterLoweringNoteLabel %>"
          data-filter-lowering-delta="<%= filterLoweringDeltaValue %>"
          data-filter-lowering-delta-label="<%= filterLoweringDeltaLabel %>"
        data-filter-air-control="<%= airSuspensionControlValue %>"
        data-filter-shocks="<%= kitHasShockPackage(kit) ? 'with' : 'without' %>"
        data-filter-drive="<%= filterDrive %>"
        data-filter-rear-wheels="<%= filterRearWheels %>">
        <div class="set-card-layout">
          <% if (setGalleryImages.length) {
            const primaryImage = setGalleryImages[0];
            const galleryImageUrls = setGalleryImages.map(function(image) {
              return image && image.url ? image.url : '';
            }).filter(Boolean);
              const displayGalleryImageUrls = (airMasterPremiumType === 'premium'
                && Array.isArray(ceControllerGalleryImages)
                && ceControllerGalleryImages.length)
                  ? galleryImageUrls.concat(ceControllerGalleryImages)
                  : ((airMasterPremiumType === 'automatic_premium'
                    && Array.isArray(reControllerGalleryImages)
                    && reControllerGalleryImages.length)
                      ? galleryImageUrls.concat(reControllerGalleryImages)
                      : galleryImageUrls);

            const extraMontageCount = setGalleryImages.slice(1).filter(function(image) {
              return image && image.source === 'montage';
            }).length;
          %>
            <div class="set-card-media">
              <div class="set-card-gallery set-card-gallery--single" aria-label="<%= setGalleryAlt %>" data-set-card-images="<%= JSON.stringify(displayGalleryImageUrls) %>" data-set-card-alt="<%= setGalleryAlt %>">
                <button type="button" class="set-card-image-button" data-set-card-next aria-label="Volgende afbeelding van <%= kit.sku %>">
                  <span class="set-card-image-count" data-set-card-counter>1/<%= displayGalleryImageUrls.length %></span>
                  <img class="set-card-image" data-set-card-image src="<%= primaryImage.url %>" alt="<%= setGalleryAlt %>" title="<%= setGalleryAlt %>" loading="lazy" decoding="async">
                  <% if (extraMontageCount) { %>
                    <span class="set-card-image-more">+<%= extraMontageCount %> montagebeeld<%= extraMontageCount === 1 ? '' : 'en' %></span>
                  <% } %>
                </button>
                <% if (displayGalleryImageUrls.length > 1) { %>
                  <button type="button" class="set-card-image-nav set-card-image-nav--prev" data-set-card-prev aria-label="Vorige afbeelding van <%= kit.sku %>">‹</button>
                  <button type="button" class="set-card-image-nav set-card-image-nav--next" data-set-card-next aria-label="Volgende afbeelding van <%= kit.sku %>">›</button>
                <% } %>
              </div>
            </div>
          <% } %>

          <div class="set-card-body">
            <div class="set-card-head">
              <div>
                <h2 class="set-card-title">
                  <a href="/<%= type %>/<%= kit.sku.toLowerCase() %>?make=<%= slugifySegment(brand) %>&model=<%= slugifySegment(model) %><% if (generationSlug) { %>&generation=<%= generationSlug %><% } %>">
                    <%= displaySetUseTitle %>
                  </a>
                  <%
                    const setCardSpecTextForIntro = (specLines || [])
                      .map(function(line) { return String(line || ''); })
                      .join(' ');

                    const setCardMinLoadMatch = setCardSpecTextForIntro.match(/Minimale belading\s*(\d+)\s*kg/i);

                    const setCardCommercialModels = new Set([
                      'caddy', 'transporter', 'crafter', 'sprinter', 'transit',
                      'ducato', 'boxer', 'jumper', 'movano', 'vito',
                      'trafic', 'vivaro', 'expert', 'scudo', 'proace',
                      'nv300', 'master', 'daily', 'talento', 'primastar',
                      'interstar', 'custom'
                    ]);

                    let setCardIntroFinal = String(displaySetUseText || '');

                    if (
                      setCardMinLoadMatch &&
                      /vrijwel altijd veel extra gewicht aanwezig/i.test(setCardIntroFinal)
                    ) {
                      setCardIntroFinal = 'Geschikt bij vrijwel altijd aanwezige extra belading vanaf ca. ' + setCardMinLoadMatch[1] + ' kg.';
                    }

                    if (
                      setCardCommercialModels.has(slugifySegment(typeof model !== 'undefined' ? model : '')) &&
                      /caravan|fietsendrager|vakantie/i.test(setCardIntroFinal)
                    ) {
                      setCardIntroFinal = 'Geschikt voor dagelijks werkgebruik, wisselende belading, gereedschap, voorraad of bedrijfswageninrichting.';
                    }
                  %>
                  <% if (setCardIntroFinal) { %>
                    <div class="set-card-type set-card-type--intro"><%= setCardIntroFinal %></div>
                  <% } %>
                  <% if (hasFitmentBadges) { %>
                    <div class="set-card-type fitment-line">
                      <strong>Past op:</strong>
                      <div class="fitment-badges" aria-label="Past op">
                        <% fitmentBadges.forEach(function(badge) { %>
                          <span class="fitment-badge fitment-badge--<%= badge.type %>">
                            <% if (badge.icon) { %>
                              <span class="fitment-badge__icon" aria-hidden="true"><%- typeof getFitmentBadgeIconSvg === 'function' ? getFitmentBadgeIconSvg(badge.icon) : '' %></span>
                            <% } %>
                            <span class="fitment-badge__label"><%= badge.label %></span>
                          </span>
                        <% }); %>
                      </div>
                    </div>
                  <% } %>
                  <% if (setUseDetail) { %>
                    <div class="set-card-type set-card-type--detail"><%= setUseDetail %></div>
                  <% } %>
                  <% if (setUseWarning) { %>
                    <div class="set-card-type set-card-type--warning"><strong>Let op:</strong> <%= setUseWarning %></div>
                  <% } %>
                  <% if (!hasFitmentBadges && hardCompatibilityNote) { %>
                    <div class="set-card-type"><strong>Past op:</strong> <%= hardCompatibilityNote %></div>
                  <% } %>
                  <% if (visibleExecutionNote) { %>
                    <div class="set-card-type"><strong>Let op uitvoering:</strong> <%= visibleExecutionNote %></div>
                  <% } %>
                <% if (cardSubtitle) { %>
                  <div class="set-card-type set-card-type--sku"><%= kit.sku %> — <% if (type === "hulpveren") { %>MAD <% } %><%= cardSubtitle %></div>
                  <% if (loweringDeltaLabel) { %>
                    <div class="set-card-type set-card-type--lowering">Verlaging: <%= loweringDeltaLabel %></div>
                  <% } %>
                <% } else { %>
                  <div class="set-card-type set-card-type--sku"><% if (type === "hulpveren") { %>MAD <% } %><%= kit.sku %></div>
                <% } %>
              </div>

              <% if (typeof totalPrice !== "undefined" && totalPrice) { %>
                <div class="set-card-price">
                  <% const setCardPricePosition = String(kit.position || kit.axle || '').trim().toLowerCase(); %>
                  <% const setCardPriceIncludesAlignment = type === 'verlagingsveren' && (setCardPricePosition === 'front' || setCardPricePosition === 'both' || setCardPricePosition === 'front,rear'); %>
                  <span><%= setCardPriceIncludesAlignment ? 'Prijs incl. montage, uitlijnen & btw' : 'Prijs incl. montage & btw' %></span>
                  <strong>€ <%= totalPrice.toLocaleString('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                </div>
              <% } %>
            </div>

            <div class="set-card-badges">
              <% if (loadTypeBadgeLabel) { %><span class="set-card-badge"><%= loadTypeBadgeLabel %></span><% } %>
              <% if (supportBadgeLabel) { %><span class="set-card-badge"><%= supportBadgeLabel %></span><% } %>
              <% if (functionBadgeLabel) { %><span class="set-card-badge"><%= functionBadgeLabel %></span><% } %>
              <% if (automaticHeightOnlyBadgeLabel) { %>
                <details class="set-card-inline-info set-card-inline-info--automatic">
                  <summary class="set-card-inline-info__summary">
                    <span class="set-card-badge set-card-badge--automatic"><%= automaticHeightOnlyBadgeLabel %></span>
                    <span class="set-card-inline-info__button" aria-label="Meer informatie">i</span>
                  </summary>
                  <div class="set-card-inline-info__panel">
                    <strong><%= automaticHeightOnlyInfoTitle %></strong>
                    <p><%= automaticHeightOnlyInfoText %></p>
                  </div>
                </details>
              <% } %>
                <% if (airMasterPremiumBadgeLabel) { %>
                  <details class="set-card-inline-info set-card-inline-info--premium">
                    <summary class="set-card-inline-info__summary">
                      <span class="set-card-badge set-card-badge--premium"><%= airMasterPremiumBadgeLabel %></span>
                      <span class="set-card-inline-info__button" aria-label="Meer informatie">i</span>
                    </summary>
                    <div class="set-card-inline-info__panel">
                      <strong><%= airMasterPremiumInfoTitle %></strong>
                      <p><%= airMasterPremiumInfoText %></p>
                      <% if (airMasterControllerMediaConfig && airMasterControllerMediaItems.length) { %>
                        <div class="airmaster-controller-media" data-controller-media="airmaster-controller-media-v1" style="margin-top:14px;padding:14px;border-radius:14px;background:#0f172a;border:1px solid rgba(255,255,255,.10);">
                          <strong style="display:block;margin-bottom:6px;"><%= airMasterControllerMediaConfig.title %></strong>
                          <p style="margin:0 0 12px;color:#cbd5e1;"><%= airMasterControllerMediaConfig.text %></p>

                          <div class="airmaster-controller-media__grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;">
                            <% airMasterControllerMediaItems.forEach(function(item) { %>
                              <figure style="margin:0;padding:10px;border-radius:12px;background:#111827;border:1px solid rgba(255,255,255,.10);">
                                <img src="<%= item.src %>" alt="<%= item.alt %>" loading="lazy" style="display:block;width:100%;height:auto;border-radius:10px;">
                                <% if (item.caption) { %>
                                  <figcaption style="margin-top:8px;font-size:.9rem;color:#cbd5e1;"><%= item.caption %></figcaption>
                                <% } %>
                              </figure>
                            <% }) %>
                          </div>
                        </div>
                      <% } %>
                    </div>
                  </details>
                <% } %>
              <% if (airMasterValveBadgeLabel) { %>
                <details class="set-card-inline-info set-card-inline-info--valve">
                  <summary class="set-card-inline-info__summary">
                    <span class="set-card-badge set-card-badge--valve"><%= airMasterValveBadgeLabel %></span>
                    <span class="set-card-inline-info__button" aria-label="Meer informatie">i</span>
                  </summary>
                  <div class="set-card-inline-info__panel">
                    <strong><%= airMasterValveInfoTitle %></strong>
                    <p><%= airMasterValveInfoText %></p>
                  </div>
                </details>
              <% } %>
              <% if (airMasterComfortControlBadgeLabel) { %>
                <details class="set-card-inline-info set-card-inline-info--comfort-control">
                  <summary class="set-card-inline-info__summary">
<span class="set-card-badge set-card-badge--comfort-control"><%= airMasterComfortControlBadgeLabel %></span>
                    <span class="set-card-inline-info__button" aria-label="Meer informatie">i</span>
                  </summary>
                  <div class="set-card-inline-info__panel">
                    <strong><%= airMasterComfortControlInfoTitle %></strong>
                    <p><%= airMasterComfortControlInfoText %></p>
                  </div>
                </details>
              <% } %>
                <% if (type === 'luchtvering' && specLines.some(function(line) { return /comfort\s+kit/i.test(String(line || '')); })) { %>
                <details class="set-card-inline-info set-card-inline-info--comfort-kit">
                  <summary class="set-card-inline-info__summary">
                    <span class="set-card-badge set-card-badge--comfort">Comfort kit: extra veerweg</span>
                    <span class="set-card-inline-info__button" aria-label="Meer informatie">i</span>
                  </summary>
                  <div class="set-card-inline-info__panel">
                    <strong>Wat betekent Comfort kit?</strong>
                    <p>Deze Comfort kit gebruikt luchtbalgen met extra veerweg. Daardoor kan de vering meer beweging opvangen en blijft het voertuig comfortabeler bij beladen én onbeladen rijden. Dit is vooral interessant voor campers, buscampers, taxi’s en voertuigen waarbij rijcomfort belangrijk is. De set helpt ook de stabiliteit en wegligging te verbeteren.</p>
                  </div>
                </details>
              <% } %>
              <% if (positionBadgeLabel) { %><span class="set-card-badge"><%= positionBadgeLabel %></span><% } %>
              <% if (filterDriveLabel) { %><span class="set-card-badge"><%= filterDriveLabel %></span><% } %>
              <% if (filterRearWheelsLabel) { %><span class="set-card-badge"><%= filterRearWheelsLabel %></span><% } %>
              <% if (approvalBadgeLabel) { %><span class="set-card-badge"><%= approvalBadgeLabel %></span><% } %>
              <% if (timeBadgeLabel) { %><span class="set-card-badge"><%= timeBadgeLabel %></span><% } %>
            </div>

            <details class="set-card-technical">
              <summary>Technische details</summary>

              <div class="set-card-specs">
                <% if (engineLabel) { %><div class="set-card-spec"><strong>Motor / uitvoering</strong><br><span><%= typeof normalizeSetTechnicalText === "function" ? normalizeSetTechnicalText(engineLabel) : engineLabel %></span></div><% } %>
                  <% if (loweringDeltaLabel) { %><div class="set-card-spec"><strong>Verlaging</strong><br><span><%= loweringDeltaLabel %></span></div><% } %>
                <% if (powertrainsLabel) { %><div class="set-card-spec"><strong>Aandrijving</strong><br><span><%= powertrainsLabel %></span></div><% } %>
                <% if (rearWheelsLabel) { %><div class="set-card-spec"><strong>Achterwielen</strong><br><span><%= rearWheelsLabel %></span></div><% } %>
                <% if (airSuspensionControlLabel) { %><div class="set-card-spec"><strong>Bediening</strong><br><span><%= airSuspensionControlLabel %></span></div><% } %>
                <% if (eanLabel) { %><div class="set-card-spec set-card-spec--muted"><strong>EAN</strong><br><span><%= eanLabel %></span></div><% } %>
              </div>

              <% if (specLines.length) { %>
                <div class="set-card-notes">
                  <strong>Toepassing / specificaties</strong>
                  <ul>
                      <% specLines.slice(0, 3).forEach(function(line){
                        let cleanSpecLine = String(line || '').replace(/Schokdemperlengt[e]+/gi, 'Schokdemperlengte');

                        if (
                          setCardMinLoadMatch &&
                          /vrijwel altijd aanwezige extra belading vanaf ca\./i.test(String(setCardIntroFinal || ''))
                        ) {
                          cleanSpecLine = cleanSpecLine
                            .replace(/,?\s*Minimale belading\s*\d+\s*kg\s*,?/i, ', ')
                            .replace(/,\s*,/g, ',')
                            .replace(/^\s*,\s*|\s*,\s*$/g, '')
                            .replace(/\s{2,}/g, ' ')
                            .trim();
                        }

                        if (!cleanSpecLine) return;
                      %>
                        <li><%= cleanSpecLine %></li>
                      <% }) %>
                  </ul>
                </div>
              <% } %>
            </details>

            <div class="set-card-actions">
              <% if (typeof totalPrice !== "undefined" && totalPrice) { %>
                <a class="btn" href="#afspraak-aanvragen" data-set-appointment data-set-sku="<%= kit.sku %>" data-set-label="<%= kit.sku %> — <%= displaySetUseTitle %><% if (String(kit.sku || '').toUpperCase().startsWith('SD-')) { %> incl. aangepaste schokdempers<% } %>" aria-label="Kies set <%= kit.sku %> voor aanvraag">Kies deze set</a>
              <% } else { %>
                <a class="btn" href="#afspraak-aanvragen" data-set-appointment data-set-sku="<%= kit.sku %>" data-set-label="<%= kit.sku %> — <%= displaySetUseTitle %><% if (String(kit.sku || '').toUpperCase().startsWith('SD-')) { %> incl. aangepaste schokdempers<% } %>" aria-label="Kies set <%= kit.sku %> voor aanvraag">Kies deze set</a>
              <% } %>
              <a class="btn btn-secondary" href="/<%= type %>/<%= kit.sku.toLowerCase() %>?make=<%= slugifySegment(brand) %>&model=<%= slugifySegment(model) %><% if (generationSlug) { %>&generation=<%= generationSlug %><% } %>" aria-label="Specificaties bekijken van <%= kit.sku %>">Specificaties bekijken</a>
            </div>
          </div>
        </div>
      </article>
<% }) %>

