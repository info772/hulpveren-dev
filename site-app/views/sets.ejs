<script>
(function () {
  function onReady(fn) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fn);
    } else {
      fn();
    }
  }

  onReady(function () {
    const appointmentBlock = document.getElementById('afspraak-aanvragen');
    if (!appointmentBlock) return;

    const skuInput = appointmentBlock.querySelector('input[name="sku"]');
    if (!skuInput) return;

    let setLabelInput = appointmentBlock.querySelector('input[name="setLabel"]');
    if (!setLabelInput) {
      setLabelInput = document.createElement('input');
      setLabelInput.type = 'hidden';
      setLabelInput.name = 'setLabel';

      const form = appointmentBlock.querySelector('form');
      if (form) form.appendChild(setLabelInput);
    }

    let selectedInfo = appointmentBlock.querySelector('[data-selected-set-info]');
    if (!selectedInfo) {
      selectedInfo = document.createElement('div');
      selectedInfo.className = 'form-selected-set';
      selectedInfo.setAttribute('data-selected-set-info', '');
      selectedInfo.hidden = true;

      const form = appointmentBlock.querySelector('form');
      appointmentBlock.insertBefore(selectedInfo, form || appointmentBlock.firstChild);
    }

    document.addEventListener('click', function (event) {
      const trigger = event.target.closest('[data-set-appointment]');
      if (!trigger) return;

      const sku = trigger.getAttribute('data-set-sku') || '';
      const label = trigger.getAttribute('data-set-label') || sku;

      skuInput.value = sku;
      if (setLabelInput) setLabelInput.value = label;

      document
        .querySelectorAll('[data-set-filter-card].is-selected-set, .set-compare__table tr.is-selected-set')
        .forEach(function (item) {
          item.classList.remove('is-selected-set');
        });

      if (sku) {
        const safeSkuSelector = sku.replace(/"/g, '\\"');
        const selectedCard =
          trigger.closest('[data-set-filter-card]') ||
          document.querySelector('[data-set-filter-card][data-filter-sku="' + safeSkuSelector + '"]');

        if (selectedCard) {
          selectedCard.classList.add('is-selected-set');
        }

        const selectedCompareRow = trigger.closest('.set-compare__table tr');
        if (selectedCompareRow) {
          selectedCompareRow.classList.add('is-selected-set');
        }

        selectedInfo.textContent = 'Geselecteerde set: ' + label;
        selectedInfo.hidden = false;
      }
    });
  });
})();
</script>

