<section
  id="plate-set-filter-result"
  class="platform-block"
  data-plate-set-filter
  data-product-type="<%= type %>"
  style="display:none;margin:18px 0;"
>
  <p class="choice-helper__eyebrow" style="margin:0 0 6px;">Kentekenresultaat</p>
  <h2 id="plate-set-filter-title" style="margin:0 0 8px;"></h2>
  <p id="plate-set-filter-text" style="margin:0;"></p>
</section>

<script>
(function () {
  const root = document.querySelector("[data-plate-set-filter]");
  if (!root) return;

  const params = new URLSearchParams(window.location.search || "");
  const plate = String(params.get("kt") || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
  if (!plate) return;

  const productType = root.getAttribute("data-product-type") || "";
  const groupByType = {
    hulpveren: "hulpveren",
    luchtvering: "luchtvering",
    verlagingsveren: "verlagingsveren"
  };

  const labelByType = {
    hulpveren: "hulpveren",
    luchtvering: "luchtvering",
    verlagingsveren: "verlagingsveren"
  };

  function getCardSku(card) {
    return String(card.getAttribute("data-filter-sku") || "")
      .trim()
      .toUpperCase();
  }

  function updateFilterCount() {
    const countEl = document.querySelector("[data-set-filter-count]");
    if (!countEl) return;

    const visibleCards = Array.from(document.querySelectorAll("[data-set-filter-card]"))
      .filter(function (card) {
        return !card.hidden && card.style.display !== "none";
      });

    countEl.textContent = visibleCards.length === 1
      ? "1 passende set"
      : visibleCards.length + " passende sets";
  }

  async function init() {
    try {
      const groupKey = groupByType[productType];
      if (!groupKey) return;

      const res = await fetch("/api/plate/solutions/" + encodeURIComponent(plate.toLowerCase()), {
        headers: { "Accept": "application/json" },
        cache: "no-store"
      });

      if (!res.ok) return;

      const data = await res.json();
      const group = data && data.solutions ? data.solutions[groupKey] : null;
      const items = group && group.available && Array.isArray(group.items) ? group.items : [];

      const allowedSkus = new Set(items
        .map(function (item) { return String(item.reference || "").trim().toUpperCase(); })
        .filter(Boolean)
      );
      if (!allowedSkus.size) return;

      const cards = Array.from(document.querySelectorAll("[data-set-filter-card]"));
      if (!cards.length) return;

      let shown = 0;
      cards.forEach(function (card) {
        const sku = getCardSku(card);
        const keep = allowedSkus.has(sku);

        if (!keep) {
          card.style.display = "none";
          card.setAttribute("data-plate-filter-hidden", "1");
        } else {
          card.removeAttribute("data-plate-filter-hidden");
          shown += 1;
        }
      });

        Array.from(document.querySelectorAll("[data-set-filter-row]")).forEach(function (row) {
          const sku = getCardSku(row);
          const keep = allowedSkus.has(sku);

          if (!keep) {
            row.style.display = "none";
            row.setAttribute("data-plate-filter-hidden", "1");
          } else {
            row.removeAttribute("data-plate-filter-hidden");
          }
        });

      function formatPlateDisplay(value) {
        const p = String(value || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
        let out = "";

        for (let i = 0; i < p.length; i++) {
          const current = p.charAt(i);
          const previous = i > 0 ? p.charAt(i - 1) : "";
          const currentIsDigit = /[0-9]/.test(current);
          const previousIsDigit = /[0-9]/.test(previous);

          if (i > 0 && currentIsDigit !== previousIsDigit) out += "-";
          out += current;
        }

        return out || String(value || "").toUpperCase();
      }

      const vehicle = data.vehicle || {};
      const vehicleText = [vehicle.make, vehicle.model, vehicle.type].filter(Boolean).join(" ");

      document.getElementById("plate-set-filter-title").textContent =
        "Passende " + (labelByType[productType] || "sets") + " voor kenteken " + formatPlateDisplay(plate);

      document.getElementById("plate-set-filter-text").textContent =
        (vehicleText ? vehicleText + " – " : "") +
        shown + " passende set" + (shown === 1 ? "" : "s") + " gevonden: " +
        Array.from(allowedSkus).join(", ");

      root.style.display = "";
      updateFilterCount();
      document.dispatchEvent(new Event("plate-set-filter:updated"));
    } catch (err) {
      return;
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>

<%
const isHiddenNrRightHandDriveKit = function(k) {
  if (type !== 'luchtvering') return false;

  const sku = String(k && k.sku || '').trim().toUpperCase();

  /* Bekende rechtsgestuurde Ducato/Jumper/Boxer/Movano set */
  if (/^NR-137914(?:-|$)/i.test(sku)) return true;

  const currentBrand = slugifySegment(brand || '');
  const currentModel = slugifySegment(model || '');

  const matchedFitments = (k.fitments || []).filter(function(f) {
    return slugifySegment(f.make || '') === currentBrand
      && slugifySegment(f.model || '') === currentModel;
  });

  if (!matchedFitments.length) return false;

  return matchedFitments.some(function(f) {
    const text = String([
      f.engine_raw,
      f.remark,
      f.notes
    ].filter(Boolean).join(' ')).toLowerCase();

    return text.indexOf('right hand drive') !== -1
      || text.indexOf('rechtsgestuurd') !== -1;
  });
};

const displayKits = (kits || []).filter(function(k) {
  return !isHiddenNrRightHandDriveKit(k);
});

// HV-098111 load type override.
displayKits.forEach(function(loadTypeOverrideKit) {
  const loadTypeOverrideSku = String(loadTypeOverrideKit && loadTypeOverrideKit.sku || '').trim().toUpperCase().replace(/^SD-/, 'HV-');
  if (loadTypeOverrideSku === 'HV-098111') {
    loadTypeOverrideKit.classification = loadTypeOverrideKit.classification && typeof loadTypeOverrideKit.classification === 'object'
      ? loadTypeOverrideKit.classification
      : {};
    loadTypeOverrideKit.classification.load_type = 'continue_belading';
  }

  // HV-368128 load type override.
  if (loadTypeOverrideSku === 'HV-368128') {
    loadTypeOverrideKit.classification = loadTypeOverrideKit.classification && typeof loadTypeOverrideKit.classification === 'object'
      ? loadTypeOverrideKit.classification
      : {};
    loadTypeOverrideKit.classification.load_type = 'zware_continue_belading';
  }
});

const total = displayKits.length;
let hasRear = false;
let hasFront = false;
let hasTuv = false;
let minPrice = null;
let maxPrice = null;
let yearFrom = null;
let yearTo = null;

displayKits.forEach(k => {
  if (k.position === "rear") hasRear = true;
  if (k.position === "front") hasFront = true;
  if ((k.approval_nl || "").toUpperCase().includes("TÜV")) hasTuv = true;

  if (k.pricing_nl && (k.pricing_nl.public_price_incl_vat_eur != null || k.pricing_nl.total_inc_vat_from_eur != null)) {
    const price = k.pricing_nl.public_price_incl_vat_eur != null
      ? Number(k.pricing_nl.public_price_incl_vat_eur)
      : Number(k.pricing_nl.total_inc_vat_from_eur);
    if (!minPrice || price < minPrice) minPrice = price;
    if (!maxPrice || price > maxPrice) maxPrice = price;
  }

  (k.fitments || []).forEach(f => {
    if (f.year_from && (!yearFrom || f.year_from < yearFrom)) yearFrom = f.year_from;
    if (f.year_to && f.year_to !== "" && (!yearTo || f.year_to > yearTo)) yearTo = f.year_to;
  });
});
%>



