<!-- set filter script -->
<script>
(() => {
  const form = document.querySelector('[data-set-filter-form]');
  const cards = Array.from(document.querySelectorAll('[data-set-filter-card]'));
  const rows = Array.from(document.querySelectorAll('[data-set-filter-row]'));
  if (!form || !cards.length) return;

  const configs = [
      {
        name: 'airControl',
        datasetKey: 'filterAirControl',
        allLabel: 'Alle bedieningen',
        disabledLabel: 'Geen keuze nodig',
        labels: {
          manual_pump: 'Oppompen met bandenpomp',
          universal_panel_compressor: 'Universeel bedieningspaneel + compressor',
          vehicle_specific_panel_compressor: 'Voertuigspecifiek bedieningspaneel + compressor',
          height_sensor_compressor: 'Hoogtesensor + compressor',
          handheld_controller_compressor: 'Handheld controller + compressor'
        },
        order: [
          'manual_pump',
          'universal_panel_compressor',
          'vehicle_specific_panel_compressor',
          'height_sensor_compressor',
          'handheld_controller_compressor'
        ]
      },
        {
          name: 'engine',
          datasetKey: 'filterEngine',
          labelDatasetKey: 'filterEngineLabel',
          labelMapDatasetKey: 'filterEngineLabels',
          allLabel: 'Alle motoren / uitvoeringen',
          disabledLabel: 'Geen keuze nodig',
          labels: {},
          order: []
        },
        {
          name: 'loweringDelta',
          datasetKey: 'filterLoweringDelta',
          labelDatasetKey: 'filterLoweringDeltaLabel',
          allLabel: 'Alle verlagingen',
          disabledLabel: 'Kies eerst motor / uitvoering',
          labels: {},
          order: []
        },
        {
          name: 'loweringNote',
          datasetKey: 'filterLoweringNote',
          labelDatasetKey: 'filterLoweringNoteLabel',
          allLabel: 'Alle uitvoeringen / toepassingen',
          disabledLabel: 'Geen keuze nodig',
          labels: {},
          order: []
        },
        {
          name: 'position',
      datasetKey: 'filterPosition',
      allLabel: 'Alle assen',
      disabledLabel: 'Geen keuze nodig',
      labels: {
        rear: 'Achteras',
        front: 'Vooras',
        'front,rear': 'Voor & achter',
        both: 'Voor & achter'
      },
      order: ['rear', 'front', 'front,rear', 'both']
    },
    {
      name: 'loadType',
      datasetKey: 'filterLoadType',
      allLabel: 'Alle gebruiken',
      disabledLabel: 'Geen keuze nodig',
      labels: {
        voorzijde_verhogen: 'Voorzijde verhogen/versterken',
        leeg_beladen: 'Normaal gebruik / af en toe beladen',
        continue_belading: 'Vaste belading',
        zware_continue_belading: '<%= (new Set(["caddy","transporter","crafter","sprinter","transit","custom","ducato","boxer","jumper","movano","vito","trafic","vivaro","expert","scudo","proace","nv300","nv400","master","daily","talento","primastar","interstar","partner","berlingo","kangoo","combo","connect","courier","promaster"])).has(slugifySegment(typeof model !== "undefined" ? model : "")) ? "Zware vaste belading" : "Extra ondersteuning" %>',
        regelbare_ondersteuning: 'Regelbare ondersteuning'
      },
      order: ['voorzijde_verhogen', 'leeg_beladen', 'continue_belading', 'zware_continue_belading', 'regelbare_ondersteuning']
    },
    {
      name: 'shocks',
      datasetKey: 'filterShocks',
      allLabel: 'Alle schokdemperkeuzes',
      disabledLabel: 'Geen keuze nodig',
      labels: {
        without: 'Zonder aangepaste schokdempers',
        with: 'Met aangepaste schokdempers'
      },
      order: ['without', 'with']
    },
    {
      name: 'drive',
      datasetKey: 'filterDrive',
      allLabel: 'Alle aandrijvingen',
      disabledLabel: 'Kies eerst as / gebruik',
      requireComplete: true,
      labels: {
        fwd: 'Voorwielaandrijving',
        rwd: 'Achterwielaandrijving',
        '4wd': 'Vierwielaandrijving'
      },
      order: ['fwd', 'rwd', '4wd']
    },
    {
      name: 'rearWheels',
      datasetKey: 'filterRearWheels',
      allLabel: 'Alle achterwielen',
      disabledLabel: 'Kies eerst as / gebruik',
      requireComplete: true,
      labels: {
        single: 'Enkellucht',
        double: 'Dubbellucht'
      },
      order: ['single', 'double']
    }
  ].map((config) => ({
    ...config,
    select: form.querySelector(`[data-set-filter="${config.name}"]`)
  })).filter((config) => config.select);

  const reset = form.querySelector('[data-set-filter-reset]');
  const count = form.querySelector('[data-set-filter-count]');

  function normalize(value) {
    return String(value || '').trim().toLowerCase();
  }

  function splitValues(value) {
    return normalize(value)
      .split(',')
      .map((item) => item.trim())
      .filter(Boolean);
  }

  function cardValues(card, config) {
    return splitValues(card.dataset[config.datasetKey]);
  }

  function cardHasValue(card, config, value) {
    if (!value) return true;
    return cardValues(card, config).includes(value);
  }

  function selectedValue(config) {
    return normalize(config.select && config.select.value);
  }

  function passesPrevious(card, configIndex) {
    for (let i = 0; i < configIndex; i += 1) {
      const config = configs[i];
      const value = selectedValue(config);
      if (value && !cardHasValue(card, config, value)) return false;
    }
    return true;
  }

  function orderedValues(values, config) {
    const set = new Set(values.filter(Boolean));
    const ordered = config.order.filter((value) => set.has(value));
    Array.from(set).sort().forEach((value) => {
      if (!ordered.includes(value)) ordered.push(value);
    });
    return ordered;
  }
    const dynamicLabels = {};
    configs.forEach((config) => {
      if (!config.labelDatasetKey && !config.labelMapDatasetKey) return;
      dynamicLabels[config.name] = {};

      cards.forEach((card) => {
        if (config.labelMapDatasetKey) {
          String(card.dataset[config.labelMapDatasetKey] || '').split('|').forEach((pair) => {
            const parts = pair.split('=');
            const value = normalize(parts.shift() || '');
            const label = parts.join('=').trim();

            if (value && label && !dynamicLabels[config.name][value]) {
              dynamicLabels[config.name][value] = label;
            }
          });
        }

        if (config.labelDatasetKey) {
          const label = String(card.dataset[config.labelDatasetKey] || '').trim();
          if (!label) return;

          cardValues(card, config).forEach((value) => {
            if (value && !dynamicLabels[config.name][value]) {
              dynamicLabels[config.name][value] = label;
            }
          });
        }
      });
    });

    function optionLabel(value, config) {
      return (config.labels && config.labels[value])
        || (dynamicLabels[config.name] && dynamicLabels[config.name][value])
        || value;
    }

  function disableSelect(config, label, value = '') {
    const select = config.select;
    const field = select.closest('[data-set-filter-field]');
    select.innerHTML = '';

    const option = document.createElement('option');
    option.value = value;
    option.textContent = value ? optionLabel(value, config) : label;
    select.appendChild(option);

    select.value = value;
    select.disabled = true;
    if (field) field.classList.add('is-disabled');
  }

  function enableSelect(config, values) {
    const select = config.select;
    const field = select.closest('[data-set-filter-field]');
    const previous = normalize(select.value);
    select.innerHTML = '';

    const all = document.createElement('option');
    all.value = '';
    all.textContent = config.allLabel;
    select.appendChild(all);

    values.forEach((value) => {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = optionLabel(value, config);
      select.appendChild(option);
    });

    select.disabled = false;
    if (field) field.classList.remove('is-disabled');
    select.value = values.includes(previous) ? previous : '';
  }

  function setOptions(config, activeCards, values) {

    /* loweringDelta waits for engine */

    if (config.name === 'loweringDelta') {

      const engineSelect = form.querySelector('[data-set-filter="engine"]');

      if (!normalize(engineSelect && engineSelect.value)) {

        disableSelect(config, 'Kies eerst motor / uitvoering');

        return;

      }

    }
    if (!activeCards.length) {
      disableSelect(config, config.disabledLabel || 'Geen keuze nodig');
      return;
    }

    if (config.requireComplete) {
      const hasMissing = activeCards.some((card) => !cardValues(card, config).length);
      if (hasMissing) {
        disableSelect(config, config.disabledLabel || 'Kies eerst eerdere filters');
        return;
      }
    }

    if (values.length <= 1) {
      disableSelect(config, config.disabledLabel || 'Geen keuze nodig', values[0] || '');
      return;
    }

    enableSelect(config, values);
  }

  function rebuildOptions() {
    configs.forEach((config, index) => {
      const activeCards = cards.filter((card) =>
        card.getAttribute('data-plate-filter-hidden') !== '1' && passesPrevious(card, index)
      );
      const values = orderedValues(
        activeCards.flatMap((card) => cardValues(card, config)),
        config
      );

      setOptions(config, activeCards, values);
    });
  }

  function matchesCard(card) {
    return configs.every((config) => {
      const value = selectedValue(config);
      if (!value) return true;
      return cardHasValue(card, config, value);
    });
  }

  function applyFilters() {
    rebuildOptions();

    let visible = 0;
    const visibleSkus = new Set();
    const eligibleCards = cards.filter((card) => card.getAttribute('data-plate-filter-hidden') !== '1');

    cards.forEach((card) => {
      const show = card.getAttribute('data-plate-filter-hidden') !== '1' && matchesCard(card);
      card.hidden = !show;

      if (show) {
        visible += 1;
        const sku = normalize(card.dataset.filterSku);
        if (sku) visibleSkus.add(sku);
      }
    });

    rows.forEach((row) => {
      const sku = normalize(row.dataset.filterSku);
      row.hidden = sku ? !visibleSkus.has(sku) : false;
    });

    if (count) {
      count.textContent = visible === eligibleCards.length
        ? `${visible} sets`
        : `${visible} van ${eligibleCards.length} sets`;
    }
  }

  configs.forEach((config) => {
    config.select.addEventListener('change', applyFilters);
  });
  document.addEventListener('plate-set-filter:updated', applyFilters);

  if (reset) {
    reset.addEventListener('click', () => {
      configs.forEach((config) => {
        config.select.value = '';
      });
      applyFilters();
    });
  }

  applyFilters();
})();
</script>

<!-- set-card image navigation -->
<script>
(() => {
  const galleries = document.querySelectorAll('.set-card .set-card-gallery--single[data-set-card-images]');

  galleries.forEach((gallery) => {
    let images = [];

    try {
      images = JSON.parse(gallery.dataset.setCardImages || '[]').filter(Boolean);
    } catch (err) {
      images = [];
    }

    if (images.length <= 1) return;

    let index = 0;
    const img = gallery.querySelector('[data-set-card-image]');
    const counter = gallery.querySelector('[data-set-card-counter]');
    const altBase = gallery.dataset.setCardAlt || 'Set afbeelding';

    const render = () => {
      if (!img) return;
      img.src = images[index];
      img.alt = `${altBase} afbeelding ${index + 1} van ${images.length}`;
      img.title = img.alt;
      if (counter) counter.textContent = `${index + 1}/${images.length}`;
    };

    gallery.querySelectorAll('[data-set-card-prev]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        index = (index - 1 + images.length) % images.length;
        render();
      });
    });

    gallery.querySelectorAll('[data-set-card-next]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        index = (index + 1) % images.length;
        render();
      });
    });
  });
})();
</script>



<script>
(function() {
  function hideUselessSetFilters() {
    const cards = Array.from(document.querySelectorAll('[data-set-filter-card]'));
    const filterBlocks = Array.from(document.querySelectorAll('.set-filter'));

    if (!filterBlocks.length || !cards.length) return;

    filterBlocks.forEach(function(filterBlock) {
      const selects = Array.from(filterBlock.querySelectorAll('select[data-set-filter]'));

      const usefulSelects = selects.filter(function(select) {
        const realOptions = Array.from(select.options || []).filter(function(option) {
          const value = String(option.value || '').trim();
          return value && !option.disabled;
        });

        return realOptions.length > 1;
      });
      const allowTwoCards = filterBlock.getAttribute('data-set-filter-allow-two') === 'true';

      if ((!allowTwoCards && cards.length <= 2) || usefulSelects.length === 0) {
        filterBlock.hidden = true;
        filterBlock.setAttribute('aria-hidden', 'true');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(hideUselessSetFilters, 0);
      setTimeout(hideUselessSetFilters, 250);
    });
  } else {
    setTimeout(hideUselessSetFilters, 0);
    setTimeout(hideUselessSetFilters, 250);
  }
})();
</script>


<script>
(function () {
  function onReady(fn) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fn);
    } else {
      fn();
    }
  }

  onReady(function () {
    const filterForm = document.querySelector('[data-set-filter-form]');
    const cards = Array.from(document.querySelectorAll('[data-set-filter-card]'));

    if (!filterForm || !cards.length) return;

    let emptyMessage = document.querySelector('[data-set-filter-empty-message]');
    if (!emptyMessage) {
      emptyMessage = document.createElement('div');
      emptyMessage.className = 'set-filter-empty-message';
      emptyMessage.setAttribute('data-set-filter-empty-message', '');
      emptyMessage.hidden = true;
      emptyMessage.innerHTML = ''
        + '<strong>Geen passende sets gevonden met deze filters.</strong>'
        + '<span>Pas je keuze aan of reset de filters.</span>'
        + '<button type="button" class="set-filter-empty-message__reset">Reset filters</button>';

      filterForm.insertAdjacentElement('afterend', emptyMessage);
    }

    const emptyReset = emptyMessage.querySelector('.set-filter-empty-message__reset');
    const mainReset = filterForm.querySelector('[data-set-filter-reset]');

    function isCardVisible(card) {
      if (!card || card.hidden) return false;
      const style = window.getComputedStyle(card);
      return style.display !== 'none' && style.visibility !== 'hidden';
    }

    function updateEmptyMessage() {
      const visibleCount = cards.filter(isCardVisible).length;
      emptyMessage.hidden = visibleCount !== 0;
    }

    filterForm.addEventListener('change', function () {
      window.setTimeout(updateEmptyMessage, 80);
    });

    filterForm.addEventListener('click', function () {
      window.setTimeout(updateEmptyMessage, 80);
    });

    if (emptyReset && mainReset) {
      emptyReset.addEventListener('click', function () {
        mainReset.click();
        window.setTimeout(updateEmptyMessage, 120);
      });
    }

    window.setTimeout(updateEmptyMessage, 250);
  });
})();
</script>
