    if (/(?:excl\.?|exclude(?:d|s|ing)?|except|without)\s*(?:awd|4wd)|niet\s+(?:geschikt\s+)?voor\s+awd|not\s+(?:suitable\s+)?for\s+awd|geen\s+awd|zonder\s+awd|not\s+awd|non[-\s]?awd|not\s+4wd|geen\s+4wd|zonder\s+4wd|non[-\s]?4wd|2wd\s+only|only\s+2wd/.test(sourceText)) return 'Niet geschikt voor AWD';

    // Expliciete geschiktheid.
    if (/(?:rwd|rear\s*wheel\s*drive)\s*[,/&+ ]+\s*(?:4wd|awd)|(?:4wd|awd)\s*[,/&+ ]+\s*(?:rwd|rear\s*wheel\s*drive)/.test(sourceText)) return 'Geschikt voor RWD en 4WD';
    if (/(?:fwd|front\s*wheel\s*drive)\s*[,/&+ ]+\s*(?:4wd|awd)|(?:4wd|awd)\s*[,/&+ ]+\s*(?:fwd|front\s*wheel\s*drive)/.test(sourceText)) return 'Geschikt voor FWD en 4WD';
    if (/(?:2wd)\s*[,/&+ ]+\s*(?:4wd|awd)|(?:4wd|awd)\s*[,/&+ ]+\s*(?:2wd)/.test(sourceText)) return 'Geschikt voor 2WD en 4WD';
    if (/(?:incl\.?|including|includes)\s*(?:awd|4wd)|(?:awd|4wd)\s*(?:included)/.test(sourceText)) return 'Ook geschikt voor 4WD';
    if (/only\s*(?:awd|4wd)|alleen\s*(?:awd|4wd)|uitsluitend\s*(?:awd|4wd)/.test(sourceText)) return 'Alleen geschikt voor 4WD';
    if (/awd|4wd|all\s*wheel\s*drive|vierwielaandrijving/.test(sourceText)) return '4WD-uitvoering';
    if (/fwd|front\s*wheel\s*drive|voorwielaandrijving/.test(sourceText)) return 'Alleen geschikt voor FWD';
    if (/rwd|rear\s*wheel\s*drive|achterwielaandrijving/.test(sourceText)) return 'Alleen geschikt voor RWD';

    if (/zonder\s+niveauregeling|geen\s+niveauregeling|not\s+(?:for\s+)?(?:alc\s*)?level\s+control|without\s+(?:alc\s*)?level\s+control|excl\.?\s*(?:alc\s*)?(?:level\s+control|niveauregeling)|excl\.?\s*slc|without\s*slc|not\s+for\s*slc/.test(sourceText)) return 'Zonder niveauregeling achter';
    if (/niveauregeling|level\s+control|self\s+levelling|self\s+leveling|\bslc\b/.test(sourceText)) return 'Met niveauregeling achter';

    if (compareAttentionIsSd) return 'Met aangepaste schokdempers';

    // Alleen als het expliciet in remark/notes staat.
    if (/hybrid|hybride/.test(sourceText)) return 'Hybride uitvoering';
    if (/single\s*rear\s*wheels?|srw|enkellucht/.test(sourceText)) return 'Enkellucht';
    if (/double\s*rear\s*wheels?|twin\s*rear\s*wheels?|dual\s*rear\s*wheels?|drw|dubbellucht/.test(sourceText)) return 'Dubbellucht';

    return 'Geen extra aandachtspunt bekend';
  })(compareContextFitments);

  const compareRawPosition = comparePositionValue;
  const compareRawLoadType = compareRawPosition.indexOf('front') !== -1
    ? 'voorzijde_verhogen'
    : String(compareClassification.load_type || '').trim();
  const compareKind = String(compareKit.kind_of_kit_nl || compareKit.kind_of_kit || compareKit.family_label || '').trim().toLowerCase();
  const compareSku = String(compareKit.sku || '').trim();
  const compareShocks = compareSku.toUpperCase().startsWith('SD-') || compareKind.includes('special duty') ? 'with' : 'without';

  return {
    sku: compareSku,
    title: compareTitle,
    detail: compareDetail,
    attention: (String(compareSku || '').trim().toUpperCase().replace(/^SD-/, 'HV-') === 'HV-373148'
      ? 'Niet geschikt voor AWD'
      : (String(compareSku || '').trim().toUpperCase().replace(/^SD-/, 'HV-') === 'HV-373178'
        ? 'Alleen geschikt voor AWD'
        : compareAttention)),
    loadType: normalizeSetChoiceTitle(compareLoadType, { model: typeof model !== 'undefined' ? model : '' }),
    rawLoadType: compareRawLoadType,
    support: compareSupport,
    position: comparePosition,
    rawPosition: compareRawPosition,
    shocks: compareShocks,
    time: compareKit.time ? String(compareKit.time) + ' min' : '—',
    tuv: compareTuv,
    price: comparePrice,
    url: '/' + type + '/' + String(compareKit.sku || '').toLowerCase()
      + '?make=' + slugifySegment(brand)
      + '&model=' + slugifySegment(model)
      + (typeof generationSlug !== 'undefined' && generationSlug ? '&generation=' + generationSlug : '')
  };
}).filter(function(row) {
  return row && row.sku;
});

const choiceVehicleLabel = [formatWords(brand), formatWords(model), generationName].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();

function kitHasShockPackage(filterKit) {
  const sku = String(filterKit && filterKit.sku || '').trim().toUpperCase();
  const kind = String(filterKit && (filterKit.kind_of_kit_nl || filterKit.kind_of_kit || filterKit.family_label) || '').trim().toLowerCase();
  return sku.startsWith('SD-') || kind.includes('special duty');
}

const hasShockPackageKits = displayKits.some(function(filterKit) {
  return kitHasShockPackage(filterKit);
});

const hasNoShockPackageKits = displayKits.some(function(filterKit) {
  return !kitHasShockPackage(filterKit);
});

const showShockFilter = hasShockPackageKits && hasNoShockPackageKits;
%>

