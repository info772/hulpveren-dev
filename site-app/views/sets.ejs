<%

  const compareNormContext = function(v) {
    return String(v || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/-/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  };

  const compareGenerationSlugNorm = typeof generationSlug !== 'undefined' && generationSlug
    ? compareNormContext(generationSlug)
    : '';
  const compareGenerationNameNorm = typeof generationName !== 'undefined' && generationName
    ? compareNormContext(generationName)
    : '';

  const compareGenerationSlugParts = compareGenerationSlugNorm
    ? compareGenerationSlugNorm.split('-').filter(Boolean)
    : [];

  function compareFitmentMatchesCurrentGeneration(f) {
    if (!compareGenerationSlugNorm && !compareGenerationNameNorm) return true;
    if (
      compareNormContext(brand) === 'ford' &&
      compareNormContext(model) === 'transit'
    ) {
      const requestedTransitText = compareGenerationSlugNorm + ' ' + compareGenerationNameNorm;
      const transitTypeMatch = requestedTransitText.match(/(^|\s)(260|280|290|300|310|330|350|470|500)(\s|$)/);
      const transitPlatformMatch = requestedTransitText.match(/(^|[^a-z0-9])(v363|fa)(?=[^a-z0-9]|$)/);

      if (transitTypeMatch) {
        const transitType = transitTypeMatch[2];
        const requestedTransitPlatform = transitPlatformMatch ? transitPlatformMatch[2] : '';
        const transitText = compareNormContext([
          f.generation,
          Array.isArray(f.platform_codes) ? f.platform_codes.join(' ') : f.platform_codes,
          f.engine_raw,
          f.remark,
          f.notes
        ].filter(Boolean).join(' '));

        const hasExplicitTransitType = new RegExp('(^|\\s)' + transitType + '(\\s|$)').test(transitText);
        const hasRequestedTransitPlatform = !requestedTransitPlatform || new RegExp('(^|[^a-z0-9])' + requestedTransitPlatform + '(?=[^a-z0-9]|$)').test(transitText);
        const isGenericV363 = /(^|[^a-z0-9])v363(?=[^a-z0-9]|$)/.test(transitText);
        const hasDoubleRear = /double rear wheel|twin rear wheel|twin wheels/.test(transitText);
        const excludesDoubleRear = /excl\.? twin rear wheel|excl\.? double rear wheel|excl\.? twin wheels|niet voor twin rear wheel|niet voor double rear wheel/.test(transitText);
        const isFwd = /(^|\s)fwd(\s|$)|voorwielaandrijving/.test(transitText);
        const onlyETransit = /only e transit|only etransit/.test(transitText);

        if (!hasRequestedTransitPlatform) return false;
        if (onlyETransit && !hasExplicitTransitType) return false;
        if (hasExplicitTransitType) return true;

        if (transitType === '500' && requestedTransitPlatform === 'v363' && isGenericV363 && hasDoubleRear && !excludesDoubleRear && !isFwd) return true;

        return false;
      }
    }


    const codes = Array.isArray(f.platform_codes)
      ? f.platform_codes.filter(Boolean)
      : [];

    if (!codes.length) return true;

    const codeNorms = codes.map(function(code) {
      return compareNormContext(code);
    }).filter(Boolean);

    const combinedCodeNorm = compareNormContext(codes.join(' '));
    const compactCombinedCodeNorm = combinedCodeNorm.replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();

    if (combinedCodeNorm) {
      if (compareGenerationNameNorm && combinedCodeNorm === compareGenerationNameNorm) return true;
      if (compareGenerationSlugNorm && combinedCodeNorm === compareGenerationSlugNorm) return true;
      if (compareGenerationSlugNorm && compareGenerationSlugNorm.indexOf(compactCombinedCodeNorm) !== -1) return true;
      if (compareGenerationNameNorm && compareGenerationNameNorm.indexOf(compactCombinedCodeNorm) !== -1) return true;

      const combinedParts = compactCombinedCodeNorm.split(' ').filter(Boolean);
      if (combinedParts.length && combinedParts.every(function(part) {
        return compareGenerationSlugNorm.indexOf(part) !== -1 || compareGenerationNameNorm.indexOf(part) !== -1;
      })) {
        return true;
      }
    }

    return codeNorms.some(function(codeNorm) {
      if (!codeNorm) return false;

      if (compareGenerationNameNorm && codeNorm === compareGenerationNameNorm) return true;
      if (compareGenerationSlugNorm && codeNorm === compareGenerationSlugNorm) return true;
      if (compareGenerationSlugParts.indexOf(codeNorm) !== -1) return true;

      if (codeNorm.length > 2 && compareGenerationSlugNorm.indexOf(codeNorm) !== -1) return true;
      if (compareGenerationNameNorm.length > 2 && codeNorm.indexOf(compareGenerationNameNorm) !== -1) return true;

      return false;
    });
  }


function isCommercialChoiceModel(modelValue) {
  const commercialModels = new Set(["caddy","transporter","crafter","sprinter","transit","custom","ducato","boxer","jumper","movano","vito","trafic","vivaro","expert","scudo","proace","nv300","nv400","master","daily","talento","primastar","interstar","partner","berlingo","kangoo","combo","connect","courier","promaster"]);
  const modelSlug = typeof slugifySegment === 'function'
    ? slugifySegment(modelValue || '')
    : String(modelValue || '').trim().toLowerCase().replace(/\s+/g, '-');

  return commercialModels.has(modelSlug);
}

function normalizeSetChoiceTitle(value, context) {
  const raw = String(value || '').trim();
  const lower = raw.toLowerCase();
  const contextModel = context && context.model
    ? context.model
    : (typeof model !== 'undefined' ? model : '');
  const isCommercial = isCommercialChoiceModel(contextModel);

  if (!raw) return '';

  if (
    lower === 'voor normaal gebruik en af en toe beladen' ||
    lower === 'af en toe beladen' ||
    lower === 'leeg & beladen' ||
    lower === 'normaal gebruik / leeg & beladen'
  ) {
    return 'Normaal gebruik / af en toe beladen';
  }

  if (
    lower === 'voor continue belading' ||
    lower === 'continue belading'
  ) {
    return 'Vaste belading';
  }

  if (
    lower === 'voor zware continue belading' ||
    lower === 'zware continue belading' ||
    lower === 'zware vaste belading'
  ) {
    return isCommercial ? 'Zware vaste belading' : 'Extra ondersteuning';
  }

  return raw;
}

const compareRows = displayKits.map(function(compareKit) {

    let compareContextFitments = (compareKit.fitments || []).filter(function(f){
      return compareNormContext(f.make) === compareNormContext(brand)
        && compareNormContext(f.model) === compareNormContext(model)
        && compareFitmentMatchesCurrentGeneration(f);
    });

    const compareHasCurrentGenerationContext = !!(compareGenerationSlugNorm || compareGenerationNameNorm);
    const compareHasKitFitments = Array.isArray(compareKit.fitments) && compareKit.fitments.length > 0;

    // displayKits is al gefilterd voor deze pagina. Als de specifieke compare-fitmentmatch leeg is,
    // mag de set niet uit de vergelijking verdwijnen; gebruik dan de beschikbare kit-fitments als fallback.
    if (compareHasCurrentGenerationContext && compareHasKitFitments && !compareContextFitments.length) {
      compareContextFitments = compareKit.fitments || [];
    }


  const compareClassification = compareKit && compareKit.classification && typeof compareKit.classification === 'object'
    ? compareKit.classification
    : {};

  const compareApplicationLabel = compareKit && compareKit.application_label && typeof compareKit.application_label === 'object'
    ? compareKit.application_label
    : { title: '', text: '', detail: '', warning: '' };

  const compareLoadType = (function(value) {
    const raw = String(value || '').trim();
    if (!raw) return 'Normaal gebruik';
    if (raw === 'leeg_beladen') return 'Leeg & beladen';
    if (raw === 'continue_belading') return 'Vaste belading';
    if (raw === 'zware_continue_belading') return normalizeSetChoiceTitle('Zware vaste belading', { model: typeof model !== 'undefined' ? model : '' });
    if (raw === 'regelbare_ondersteuning') return 'Regelbaar';
    return raw.replace(/_/g, ' ');
  })(compareClassification.load_type);

  const compareSupport = (function(value) {
    const raw = String(value || '').trim();
    if (!raw || raw === 'standard') return 'Normaal';
    if (raw === 'medium') return 'Medium';
    if (raw === 'extra_heavy') return 'Extra zwaar';
    if (raw === 'air') return 'Luchtvering';
    return raw.replace(/_/g, ' ');
  })(compareClassification.support_level);

  const compareSkuForPosition = String(compareKit.sku || '').trim().toUpperCase().replace(/^SD-/, 'HV-');
  const comparePositionRawValue = String(compareKit.position || compareKit.axle || '').trim().toLowerCase().replace(/\s+/g, '');
  /* HV-098273 forced as front axle */
  const comparePositionValue = (compareSkuForPosition === 'HV-098273' || compareSkuForPosition === 'HV-068418')
    ? 'front'
    : (/^HV-\d{5}1$/.test(compareSkuForPosition) ? 'both' : comparePositionRawValue);
  const comparePosition =
    comparePositionValue === 'front' ? 'Vooras' :
    comparePositionValue === 'rear' ? 'Achteras' :
    comparePositionValue === 'both' || comparePositionValue === 'front,rear' ? 'Voor & achter' :
    String(compareKit.position || '');

  const compareApproval = String(compareKit.approval_nl || compareKit.approval || '');
  const compareTuv = /tuv|tüv/i.test(compareApproval) ? 'TÜV' : (compareApproval ? compareApproval : '—');

  const comparePrice = compareKit.pricing_nl && compareKit.pricing_nl.public_price_incl_vat_eur != null
    ? Number(compareKit.pricing_nl.public_price_incl_vat_eur)
    : (compareKit.pricing_nl && compareKit.pricing_nl.total_inc_vat_from_eur ? Number(compareKit.pricing_nl.total_inc_vat_from_eur) : null);

  const compareTitleSku = String(compareKit && compareKit.sku || '').trim().toUpperCase().replace(/^SD-/, 'HV-');
  const compareTitle = compareTitleSku === 'HV-098111'
    ? 'Vaste belading'
    : (compareTitleSku === 'HV-368128'
      ? normalizeSetChoiceTitle('Zware vaste belading', { model: typeof model !== 'undefined' ? model : '' })
      : normalizeSetChoiceTitle(String(compareApplicationLabel.title || '').trim() || compareLoadType, { model: typeof model !== 'undefined' ? model : '' }));
