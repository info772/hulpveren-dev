<% if (typeof modelIntro !== 'undefined' && modelIntro && !generationName) { %>
  <% String(modelIntro).replace(/\\n/g, '\n').split(/\n\s*\n/).filter(Boolean).forEach(function(paragraph){ %>
    <p><%= paragraph %></p>
  <% }) %>
<% } %>

